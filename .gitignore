# The three downloaded datasets are committed under data/raw/ with the
# attribution their CC BY 4.0 release requires, and data/checksums.txt records
# the digest of each so a committed file can be shown to be the released file.
# Only the partial download left by an interrupted fetch is ignored.
data/raw/*.part

# Python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Fitted models and derived arrays are rebuilt by the pipeline.
*.pkl
*.joblib
*.npz

# Large or transient intermediates
*.zip
*.log

# Working records kept locally and not part of the deliverable.
notes/
docs/project-plan.md
docs/execution-log.md
docs/gate-fault-injection.md
